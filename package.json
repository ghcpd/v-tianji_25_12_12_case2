{
  "name": "ecommerce-shopping-cart",
  "version": "1.0.0",
  "description": "A sleek, modern e-commerce shopping cart application with beautiful UI/UX design",
  "private": true,
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^1.6.1",
    "jsdom": "^23.2.0",
    "playwright": "^1.40.0",
    "vite": "^7.2.7",
    "vitest": "^1.6.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
